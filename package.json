{
  "name": "exjs-controllers",
  "version": "0.9.1",
  "description": "Declarative controllers, DTO validation, dependency injection, OpenAPI and Express bootstrap for TypeScript APIs.",
  "license": "MIT",
  "keywords": [
    "express",
    "controllers",
    "typescript",
    "decorators",
    "openapi",
    "zod"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#exjs-controllers/core/authentication": {
      "types": "./dist/core/authentication/index.d.ts",
      "default": "./dist/core/authentication/index.js"
    },
    "#exjs-controllers/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core/authentication": {
      "types": "./dist/core/authentication/index.d.ts",
      "default": "./dist/core/authentication/index.js"
    },
    "./config/*": {
      "types": "./dist/config/*.d.ts",
      "default": "./dist/config/*.js"
    },
    "./authentication/*": {
      "types": "./dist/authentication/*.d.ts",
      "default": "./dist/authentication/*.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./decorators/*": {
      "types": "./dist/decorators/*.d.ts",
      "default": "./dist/decorators/*.js"
    },
    "./entities/*": {
      "types": "./dist/entities/*.d.ts",
      "default": "./dist/entities/*.js"
    },
    "./http/*": {
      "types": "./dist/http/*.d.ts",
      "default": "./dist/http/*.js"
    },
    "./logging/*": {
      "types": "./dist/logging/*.d.ts",
      "default": "./dist/logging/*.js"
    },
    "./metadata/*": {
      "types": "./dist/metadata/*.d.ts",
      "default": "./dist/metadata/*.js"
    },
    "./observability/*": {
      "types": "./dist/observability/*.d.ts",
      "default": "./dist/observability/*.js"
    },
    "./openapi/*": {
      "types": "./dist/openapi/*.d.ts",
      "default": "./dist/openapi/*.js"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.d.ts",
      "default": "./dist/schemas/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebylito/exjs-controllers.git"
  },
  "bugs": {
    "url": "https://github.com/thebylito/exjs-controllers/issues"
  },
  "homepage": "https://github.com/thebylito/exjs-controllers#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn tsc -p tsconfig.json",
    "prepack": "npm run clean && npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "publish:dry-run": "npm publish --dry-run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@scalar/express-api-reference": "^0.10.17",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
